{
	"name": "@appartmint/tsm-scripts",
	"author": "App Art Mint LLC",
	"version": "0.3.2",
	"type": "module",
	"license": "MIT",
	"description": "TypeScript Node Scripts from App Art Mint LLC",
	"keywords": [
		"typescript",
		"modules",
		"app art mint",
		"appartmint",
		"utility",
		"scripts"
	],
	"homepage": "https://github.com/App-Art-Mint/tsm-scripts#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/App-Art-Mint/tsm-scripts.git"
	},
	"bugs": {
		"url": "https://github.com/App-Art-Mint/tsm-scripts/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src/**/*.{ts,d.ts}"
	],
	"scripts": {
		"version": "npm i && git add -A",
		"postversion": "git push && git push --tags && cross-replace gh release create \"v$npm_package_version\" --generate-notes",
		"prepare": "run-s build",
		"build": "run-p test:types",
		"clean": "rimraf dist",
		"test:types": "tsc -b",
		"test:circular": "madge --circular --extensions ts .",
		"lint": "eslint --fix .",
		"publish:link": "yalc publish",
		"check:updates": "npm-check-updates",
		"aws:amplify:branch": "tsx src/aws/amplify/branch.ts",
		"aws:amplify:delete": "tsx src/aws/amplify/delete.ts",
		"aws:amplify:sandbox": "tsx src/aws/amplify/sandbox.ts",
		"aws:sso:login": "tsx src/aws/sso/login.ts",
		"format:imports": "tsx src/format/imports.ts",
		"mint:update": "tsx src/mint/update.ts",
		"tinify:inject": "tsx src/tinify/inject-cert.ts",
		"ngx:sync": "tsx src/ngx/sync-packages.ts",
		"ngx:build": "tsx src/ngx/build-libraries.ts"
	},
	"dependencies": {
		"globby": "^14.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.1.1",
		"cross-replace": "^0.2.0",
		"eslint": "^10.0.3",
		"glob": "^13.0.6",
		"globals": "^17.4.0",
		"jiti": "^2.6.1",
		"madge": "^8.0.0",
		"npm-check-updates": "^22.2.9",
		"npm-run-all2": "^9.0.2",
		"rimraf": "^6.1.3",
		"tsx": "^4.23.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.57.0",
		"yalc": "^1.0.0-pre.53"
	}
}
